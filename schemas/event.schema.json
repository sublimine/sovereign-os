{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/event.schema.json",
  "title": "OmegaEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_type", "event_version", "aggregate_id",
    "aggregate_version", "mission_id", "actor", "occurred_at", "recorded_at",
    "correlation_id", "idempotency_key", "previous_event_hash", "payload_hash",
    "classification", "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 8},
    "event_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "event_version": {"type": "integer", "minimum": 1},
    "aggregate_id": {"type": "string"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "mission_id": {"type": "string"},
    "actor": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string"},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string"},
    "previous_event_hash": {"type": ["string", "null"]},
    "payload_hash": {"type": "string", "minLength": 16},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SECRET", "RESTRICTED"]},
    "payload": {}
  }
}

