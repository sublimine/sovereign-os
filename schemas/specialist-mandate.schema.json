{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/specialist-mandate.schema.json",
  "title": "SpecialistMandate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandate_id", "mission_id", "sponsor", "spawn_trigger", "specialist_type",
    "capabilities", "task", "context_scope", "context_exclusions", "tools",
    "permissions", "model_route", "budget", "max_children", "max_depth",
    "deadline", "output_schema", "verification_policy", "termination_conditions",
    "memory_policy", "lease"
  ],
  "properties": {
    "mandate_id": {"type": "string"},
    "mission_id": {"type": "string"},
    "sponsor": {"type": "string", "pattern": "^omega_(0[1-9]|1[0-9]|2[0-4])$"},
    "spawn_trigger": {"type": "string"},
    "specialist_type": {"type": "string"},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "task": {"type": "string", "minLength": 1},
    "context_scope": {"type": "array", "items": {"type": "string"}},
    "context_exclusions": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "model_route": {
      "type": "object",
      "required": ["minimum_tier", "maximum_tier", "reasoning_effort"],
      "properties": {
        "minimum_tier": {"enum": ["LOCAL_DETERMINISTIC", "D", "C", "B", "A"]},
        "maximum_tier": {"enum": ["LOCAL_DETERMINISTIC", "D", "C", "B", "A"]},
        "reasoning_effort": {"enum": ["low", "medium", "high", "maximum"]}
      }
    },
    "budget": {"type": "object"},
    "max_children": {"type": "integer", "minimum": 0},
    "max_depth": {"type": "integer", "minimum": 0, "maximum": 4},
    "deadline": {"type": "string", "format": "date-time"},
    "output_schema": {"type": "string"},
    "verification_policy": {"type": "object"},
    "termination_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "memory_policy": {"type": "object"},
    "lease": {"type": "object"}
  }
}

