{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/mission.schema.json",
  "title": "MissionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id", "version", "original_intent", "objective", "objective_invariants",
    "priority", "materiality", "research_depth", "activation_vector", "constraints",
    "success_criteria", "stop_conditions", "budget", "authority", "status",
    "created_at", "created_by"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 8},
    "version": {"type": "integer", "minimum": 1},
    "parent_version": {"type": ["integer", "null"], "minimum": 1},
    "original_intent": {
      "type": "object",
      "required": ["verbatim", "hash"],
      "properties": {
        "verbatim": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "minLength": 16}
      }
    },
    "objective": {"type": "string", "minLength": 1},
    "requested_method": {"type": ["string", "null"]},
    "objective_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
    "materiality": {"enum": ["M0", "M1", "M2", "M3", "M4"]},
    "research_depth": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5"]},
    "activation_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "uncertainty", "irreversibility", "factual_sensitivity", "complexity", "security_risk", "capital", "legitimacy", "duration", "novelty"],
      "properties": {
        "severity": {"type": "integer", "minimum": 0, "maximum": 5},
        "uncertainty": {"type": "integer", "minimum": 0, "maximum": 5},
        "irreversibility": {"type": "integer", "minimum": 0, "maximum": 5},
        "factual_sensitivity": {"type": "integer", "minimum": 0, "maximum": 5},
        "complexity": {"type": "integer", "minimum": 0, "maximum": 5},
        "security_risk": {"type": "integer", "minimum": 0, "maximum": 5},
        "capital": {"type": "integer", "minimum": 0, "maximum": 5},
        "legitimacy": {"type": "integer", "minimum": 0, "maximum": 5},
        "duration": {"type": "integer", "minimum": 0, "maximum": 5},
        "novelty": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "budget": {"$ref": "#/$defs/budget"},
    "authority": {
      "type": "object",
      "required": ["sovereignty_mode", "delegation_ref", "human_approval_triggers"],
      "properties": {
        "sovereignty_mode": {"enum": ["HUMAN_SOVEREIGN", "DELEGATED_SOVEREIGN"]},
        "delegation_ref": {"type": ["string", "null"]},
        "human_approval_triggers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "status": {"enum": ["DRAFT", "AUTHORIZING", "READY", "ACTIVE", "WAITING", "BLOCKED", "PAUSED", "COMPLETE", "PARTIAL", "UNKNOWN", "ABORTED", "FAILED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string"},
    "superseded_by": {"type": ["string", "null"]}
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_units", "compute_units", "wall_time_seconds", "specialist_count", "external_api_cost", "human_attention_minutes", "currency"],
      "properties": {
        "token_units": {"type": "integer", "minimum": 0},
        "compute_units": {"type": "number", "minimum": 0},
        "wall_time_seconds": {"type": "integer", "minimum": 0},
        "specialist_count": {"type": "integer", "minimum": 0},
        "external_api_cost": {"type": "number", "minimum": 0},
        "human_attention_minutes": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    }
  }
}

