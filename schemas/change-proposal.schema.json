{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sovereign.local/schemas/change-proposal.schema.json",
  "title":"ChangeProposal","type":"object","additionalProperties":false,
  "required":["change_id","version","target","current_version","proposed_version","problem","root_cause","evidence_refs","hypothesis","diff_ref","affected_dependencies","metrics","thresholds","test_plan","shadow_plan","approvals","rollout","rollback","status","created_at"],
  "properties":{
    "change_id":{"type":"string"},"version":{"type":"integer","minimum":1},"target":{"type":"string"},
    "current_version":{"type":"string"},"proposed_version":{"type":"string"},"problem":{"type":"string"},
    "root_cause":{"type":"string"},"evidence_refs":{"type":"array","items":{"type":"string"}},
    "hypothesis":{"type":"string"},"diff_ref":{"type":"string"},"affected_dependencies":{"type":"array","items":{"type":"string"}},
    "metrics":{"type":"array","minItems":1,"items":{"type":"string"}},"thresholds":{"type":"object"},
    "test_plan":{"type":"object"},"shadow_plan":{"type":"object"},"shadow_results":{"type":["object","null"]},
    "approvals":{"type":"array","items":{"type":"object"}},"rollout":{"type":"object"},"rollback":{"type":"object"},
    "status":{"enum":["PROPOSED","TESTING","SHADOW","REJECTED","APPROVED","CANARY","DEPLOYED","ROLLED_BACK","SUPERSEDED"]},
    "created_at":{"type":"string","format":"date-time"}
  }
}

