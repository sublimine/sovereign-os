{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/sigma/outputs/sigma-24-output.schema.json",
  "title": "outputs/sigma-24-output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_version",
    "mission_id",
    "producer",
    "created_at",
    "classification",
    "content_hash",
    "provenance_refs",
    "dependency_refs",
    "status",
    "artifact_type",
    "procedure",
    "accountable_outcome",
    "inputs_used",
    "procedure_trace",
    "gate_evidence",
    "findings",
    "limitations",
    "reconsideration_triggers",
    "reason_codes"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "artifact_type": {
      "const": "AllSourceFusion"
    },
    "procedure": {
      "const": "all_source_fusion"
    },
    "accountable_outcome": {
      "const": "integración de evidencia y análisis sin ocultar dependencia o contradicción"
    },
    "inputs_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "procedure_trace": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "align claims to common ontology and time",
          "group support and counterevidence by hypothesis",
          "apply source quality and dependency without double-counting",
          "preserve measurement and semantic differences",
          "identify convergence, divergence and unexplained gaps",
          "produce integrated findings with sensitivity",
          "route contradictions and replication needs",
          "publish fusion map, not flattened narrative"
        ]
      }
    },
    "gate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ONTOLOGY_ALIGNMENT",
        "DEPENDENCY_ADJUSTMENT",
        "COUNTEREVIDENCE",
        "CONTRADICTION_VISIBILITY",
        "SENSITIVITY",
        "DISSENT_PRESERVATION"
      ],
      "properties": {
        "ONTOLOGY_ALIGNMENT": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "DEPENDENCY_ADJUSTMENT": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "COUNTEREVIDENCE": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "CONTRADICTION_VISIBILITY": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "SENSITIVITY": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "DISSENT_PRESERVATION": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reconsideration_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
