{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/sigma/outputs/sigma-07-output.schema.json",
  "title": "outputs/sigma-07-output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_version",
    "mission_id",
    "producer",
    "created_at",
    "classification",
    "content_hash",
    "provenance_refs",
    "dependency_refs",
    "status",
    "artifact_type",
    "procedure",
    "accountable_outcome",
    "inputs_used",
    "procedure_trace",
    "gate_evidence",
    "findings",
    "limitations",
    "reconsideration_triggers",
    "reason_codes"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "artifact_type": {
      "const": "SourceAccessMap"
    },
    "procedure": {
      "const": "source_discovery_and_access"
    },
    "accountable_outcome": {
      "const": "mapa de fuentes y vías legales que supera rutas obvias"
    },
    "inputs_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "procedure_trace": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "enumerate direct, proxy, archival and derivative routes",
          "search registries, citations and institutional traces",
          "map access prerequisites and legal basis",
          "score expected uniqueness and observability",
          "identify buried and fragmented evidence paths",
          "design fallback and cross-language routes",
          "submit access map without credibility verdict",
          "update registry with negative search evidence"
        ]
      }
    },
    "gate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SEARCH_SPACE_MODEL",
        "LEGAL_ACCESS",
        "ROUTE_NOVELTY",
        "NEGATIVE_EVIDENCE_LOG",
        "QUERY_REPRODUCIBILITY",
        "HANDOFF_COMPLETENESS"
      ],
      "properties": {
        "SEARCH_SPACE_MODEL": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "LEGAL_ACCESS": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ROUTE_NOVELTY": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "NEGATIVE_EVIDENCE_LOG": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "QUERY_REPRODUCIBILITY": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "HANDOFF_COMPLETENESS": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reconsideration_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
