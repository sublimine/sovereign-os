{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/sigma/outputs/sigma-30-output.schema.json",
  "title": "outputs/sigma-30-output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_version",
    "mission_id",
    "producer",
    "created_at",
    "classification",
    "content_hash",
    "provenance_refs",
    "dependency_refs",
    "status",
    "artifact_type",
    "procedure",
    "accountable_outcome",
    "inputs_used",
    "procedure_trace",
    "gate_evidence",
    "findings",
    "limitations",
    "reconsideration_triggers",
    "reason_codes"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "artifact_type": {
      "const": "CounterintelligenceCase"
    },
    "procedure": {
      "const": "institutional_counterintelligence"
    },
    "accountable_outcome": {
      "const": "compromiso potencial detectado, contenido e investigado con debido proceso"
    },
    "inputs_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "procedure_trace": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "triage compromise indicator without presuming guilt",
          "freeze minimum affected compartments/routes",
          "preserve evidence and independent audit trail",
          "map possible insider, source, model, tool and process causes",
          "test benign, accidental and adversarial hypotheses",
          "scope blast radius and dependent artifacts",
          "coordinate remediation without exposing investigation",
          "close as confirmed, refuted or unresolved with monitoring"
        ]
      }
    },
    "gate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "INDICATOR_BASIS",
        "INDEPENDENCE",
        "LEAST_CONTAINMENT",
        "EVIDENCE_PRESERVATION",
        "ALTERNATIVE_CAUSES",
        "BLAST_RADIUS"
      ],
      "properties": {
        "INDICATOR_BASIS": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "INDEPENDENCE": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "LEAST_CONTAINMENT": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "EVIDENCE_PRESERVATION": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ALTERNATIVE_CAUSES": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "BLAST_RADIUS": {
          "type": "object",
          "required": [
            "outcome",
            "evidence_refs"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "RETURN",
                "ESCALATE",
                "WAIVE"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reconsideration_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
