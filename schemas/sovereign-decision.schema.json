{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sovereign.local/schemas/sovereign-decision.schema.json",
  "title":"SovereignDecision","type":"object","additionalProperties":false,
  "required":["decision_id","version","mission_id","selected_option","objective","decision_basis","claim_refs","assumptions","unknowns","dissent_refs","risk_refs","authority_ref","constraints","owner","effective_at","review_at","reversal_triggers","next_actions","status","signatures"],
  "properties":{
    "decision_id":{"type":"string"},"version":{"type":"integer","minimum":1},"mission_id":{"type":"string"},
    "selected_option":{"type":"string"},"objective":{"type":"string"},"decision_basis":{"type":"string"},
    "claim_refs":{"type":"array","items":{"type":"string"}},"assumptions":{"type":"array","items":{"type":"string"}},
    "unknowns":{"type":"array","items":{"type":"object"}},"dissent_refs":{"type":"array","items":{"type":"string"}},
    "risk_refs":{"type":"array","items":{"type":"string"}},"authority_ref":{"type":"string"},
    "constraints":{"type":"array","items":{"type":"string"}},"resource_ref":{"type":["string","null"]},
    "owner":{"type":"string"},"effective_at":{"type":"string","format":"date-time"},
    "review_at":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},
    "reversal_triggers":{"type":"array","minItems":1,"items":{"type":"string"}},
    "waiver_refs":{"type":"array","items":{"type":"string"}},"next_actions":{"type":"array","items":{"type":"object"}},
    "status":{"enum":["ISSUED","ACTIVE","REVIEW_REQUIRED","REVOKED","SUPERSEDED"]},
    "signatures":{"type":"array","minItems":1,"items":{"type":"object"}}
  }
}

