{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/evidence.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id", "version", "source_type", "source_locator",
    "source_snapshot_hash", "content_hash", "acquired_at", "acquisition_method",
    "tool_run_ref", "agent_instance_id", "chain_of_custody", "classification",
    "legal_basis", "extract_coordinates", "transformations", "trust_zone",
    "contamination_flags", "status"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 8},
    "version": {"type": "integer", "minimum": 1},
    "source_type": {"enum": ["DOCUMENT", "URL", "DATASET", "API", "OBSERVATION", "INTERVIEW", "CALCULATION", "CODE_EXECUTION", "SENSOR", "OTHER"]},
    "source_locator": {"type": "string", "minLength": 1},
    "source_snapshot_hash": {"type": "string", "minLength": 16},
    "content_hash": {"type": "string", "minLength": 16},
    "acquired_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "publisher": {"type": ["string", "null"]},
    "author": {"type": ["string", "null"]},
    "acquisition_method": {"type": "string"},
    "tool_run_ref": {"type": "string"},
    "agent_instance_id": {"type": "string"},
    "chain_of_custody": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SECRET", "RESTRICTED"]},
    "legal_basis": {"type": "string"},
    "extract_coordinates": {"type": "object"},
    "transformations": {"type": "array", "items": {"type": "object"}},
    "quality_features": {"type": "object"},
    "trust_zone": {"enum": ["UNTRUSTED_CONTENT", "VALIDATED_SOURCE", "CONTROLLED_DATA", "INSTITUTIONAL"]},
    "contamination_flags": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["ACTIVE", "QUARANTINED", "STALE", "RETRACTED", "SUPERSEDED"]},
    "superseded_by": {"type": ["string", "null"]}
  }
}

