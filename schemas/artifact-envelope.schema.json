{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/artifact-envelope.schema.json",
  "title": "ArtifactEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id", "artifact_type", "schema_id", "schema_version",
    "artifact_version", "producer", "mission_id", "created_at",
    "classification", "sensitivity", "provenance_refs", "dependency_refs",
    "content_hash", "status", "payload"
  ],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{7,127}$"},
    "artifact_type": {"type": "string", "minLength": 3},
    "schema_id": {"type": "string", "minLength": 3},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "parent_versions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "producer": {"$ref": "#/$defs/principalRef"},
    "mission_id": {"type": "string", "minLength": 8},
    "created_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SECRET", "RESTRICTED"]},
    "sensitivity": {"enum": ["S0", "S1", "S2", "S3", "S4", "S5"]},
    "provenance_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependency_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "content_hash": {"type": "string", "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"},
    "status": {"enum": ["DRAFT", "ACTIVE", "VERIFIED", "BLOCKED", "STALE", "RETRACTED", "SUPERSEDED", "QUARANTINED"]},
    "superseded_by": {"type": ["string", "null"]},
    "payload": {}
  },
  "$defs": {
    "principalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "instance_id"],
      "properties": {
        "role_id": {"type": "string"},
        "instance_id": {"type": "string"},
        "human_principal_id": {"type": ["string", "null"]}
      }
    }
  }
}

