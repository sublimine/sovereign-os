{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sovereign.local/schemas/capability-lease.schema.json",
  "title":"CapabilityLease","type":"object","additionalProperties":false,
  "required":["lease_id","version","mission_id","subject","issuer","issued_at","expires_at","actions","resources","tool_profile","classification_ceiling","budgets","conditions","revocation_triggers","signature"],
  "properties":{
    "lease_id":{"type":"string","minLength":8},"version":{"type":"integer","minimum":1},
    "mission_id":{"type":"string"},"subject":{"type":"string"},"issuer":{"type":"string"},
    "issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},
    "actions":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "resources":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "tool_profile":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "classification_ceiling":{"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","SECRET","RESTRICTED"]},
    "budgets":{"type":"object","required":["tokens","compute_units","wall_seconds","children","external_cost"],"properties":{"tokens":{"type":"number","minimum":0},"compute_units":{"type":"number","minimum":0},"wall_seconds":{"type":"number","minimum":0},"children":{"type":"integer","minimum":0},"external_cost":{"type":"number","minimum":0}}},
    "conditions":{"type":"array","items":{"type":"string"}},
    "revocation_triggers":{"type":"array","minItems":1,"items":{"type":"string"}},
    "parent_lease":{"type":["string","null"]},"delegation_depth":{"type":"integer","minimum":0,"maximum":4},
    "signature":{"type":"object","required":["algorithm","key_id","value"],"properties":{"algorithm":{"type":"string"},"key_id":{"type":"string"},"value":{"type":"string"}}}
  }
}

