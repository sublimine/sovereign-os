# Absolute executable used by the user service. Required.
SUBLIMINE_NODE_BIN=/absolute/path/to/node

# Absolute path to this checked-out Sublimine repository. Required. The
# systemd unit intentionally does not assume where the repository lives.
SUBLIMINE_REPOSITORY_DIR=/absolute/path/to/sublimine

# Factory wrapper for this installation. Required when mission execution is
# enabled; the console remains inspectable while it is absent.
SOVEREIGN_BIN=/absolute/path/to/sovereign

# Optional explicit Codex CLI location for Factory child processes.
# SUBLIMINE_CODEX_BIN=/absolute/path/to/codex
