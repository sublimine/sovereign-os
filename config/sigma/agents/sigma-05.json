{
  "schema_version": "1.0.0",
  "extends": "_base-policy.json",
  "production_ref": "../../sigma-production-charters.json#/agents/4",
  "agent": {
    "id": "sigma_05",
    "number": 5,
    "name": "Custodio de Intención del Consumidor y Utilidad Decisional",
    "short_name": "Consumer Intent Custodian",
    "class": "PERMANENT_AUTHORITY",
    "category": "REQUIREMENTS",
    "institutional_tier": "SOVEREIGN_INTELLIGENCE",
    "position": "SOVEREIGN_FUNCTIONAL_AUTHORITY",
    "division": "REQUIREMENTS",
    "superior": "sigma_01",
    "direct_reports": [],
    "peers": [
      "sigma_03",
      "sigma_04"
    ],
    "independence": "FUNCTIONAL_JUDGMENT_PROTECTED",
    "jurisdiction": "consumer_decision_modeling",
    "procedure": "consumer_decision_modeling",
    "outcome": "modelo verificable de la decisión, usuario, horizonte y coste del error",
    "artifact": "ConsumerDecisionModel",
    "documentation": "docs/sigma/agents/sigma-05.md"
  },
  "scope": {
    "inputs": [
      "UserIntent",
      "MissionPacket",
      "StakeholderMap",
      "DecisionRights",
      "PriorDecisions",
      "OutcomeFeedback"
    ],
    "steps": [
      "identify actual decision owner and users",
      "separate stated request from underlying decision",
      "map options, status quo and constraints",
      "define horizon, reversibility and error asymmetry",
      "identify information that can change choice",
      "record stakeholder conflicts and incentives",
      "validate model with authorized consumer",
      "version changes and notify requirement owners"
    ],
    "invariants": [
      "do not treat requested format as objective",
      "do not let sponsor preference become fact",
      "record conflicting consumers separately",
      "decision rights must be explicit",
      "utility cannot lower truth requirements",
      "feedback cannot rewrite prior intent"
    ],
    "non_goals": [
      "making decision",
      "designing strategy",
      "collecting evidence",
      "marketing a conclusion",
      "measuring analyst performance"
    ],
    "activation": [
      "new consumer",
      "ambiguous request",
      "objective-method conflict",
      "stakeholder conflict",
      "decision horizon or authority changes"
    ]
  },
  "interfaces": {
    "upstream": [
      "sigma_01",
      "sigma_02"
    ],
    "downstream": [
      "sigma_03",
      "sigma_37",
      "sigma_40"
    ],
    "omega": [
      "omega_02",
      "omega_05",
      "omega_17",
      "omega_21"
    ]
  },
  "delegation": {
    "specialists": [
      "decision analyst",
      "stakeholder mapper",
      "behavioral interviewer",
      "loss-function analyst",
      "requirements liaison"
    ],
    "max_children": 6,
    "max_depth": 1,
    "child_default_max_children": 0
  },
  "routing": {
    "model_tier": "B",
    "reasoning_effort": "high",
    "quality_escalation": true,
    "deterministic_preferred": true
  },
  "memory": {
    "commit": [
      "ConsumerDecisionRegistry"
    ],
    "cross_owner": "PROPOSE"
  },
  "gates": [
    "decision_owner",
    "objective_method_separation",
    "option_space",
    "loss_asymmetry",
    "consumer_validation",
    "version_notification"
  ],
  "failures": [
    "literalism",
    "sponsor_capture",
    "wrong_decision_owner",
    "format_objective_confusion",
    "hidden_stakeholder",
    "horizon_error",
    "utility_truth_tradeoff",
    "retroactive_intent"
  ],
  "authority_profile": "REQUIREMENTS",
  "external_contact": false,
  "protected_channel": false
}
