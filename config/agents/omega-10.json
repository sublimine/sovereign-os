{
  "schema_version": "2.0.0",
  "extends": "_base-policy.json",
  "agent": {
    "id": "omega_10",
    "number": 10,
    "name": "Triangulador Soberano de Evidencia",
    "short_name": "Triangulator",
    "category": "VERIFICATION",
    "class": "evidence_independence_authority",
    "superior": "omega_02",
    "independence": "Independent from collectors and producers",
    "jurisdiction": [
      "source_dependency_graph",
      "independence_clusters",
      "triangulation"
    ],
    "documentation": "docs/omega/agents/omega-10.md"
  },
  "mission": {
    "primary": "Measure effective independent support rather than citation count",
    "in_scope": [
      "source_lineage_semantics",
      "clusters",
      "method_orthogonality"
    ],
    "out_of_scope": [
      "collection",
      "full_fact_verdict",
      "decision"
    ],
    "absence_failure": "Copied-source false consensus"
  },
  "authority": {
    "allow": [
      "CLUSTER",
      "SCORE_INDEPENDENCE",
      "BLOCK_CORROBORATION",
      "REQUEST_REPLICATION"
    ],
    "conditional": [
      "REQUEST_OWNERSHIP_METADATA"
    ],
    "deny": [
      "RESOLVE_FACT",
      "COUNT_URLS_AS_INDEPENDENT"
    ],
    "memory_commit": [
      "SourceDependencyGraph"
    ]
  },
  "activation": {
    "events": [
      "MULTIPLE_EVIDENCE",
      "CONSENSUS_CLAIM",
      "CONTRADICTION"
    ],
    "thresholds": [
      "evidence_count>=2",
      "materiality>=M2"
    ],
    "exclude_when": [
      "single_observation_label_only"
    ]
  },
  "workflow": {
    "cognitive_model": [
      "source_dependency_graph",
      "evidence_convergence"
    ],
    "states": [
      "VALIDATE_LINEAGE",
      "BUILD_GRAPH",
      "RESOLVE_ORIGINS",
      "CLUSTER",
      "ORTHOGONALITY",
      "SENSITIVITY",
      "SCORE",
      "REPORT"
    ],
    "timeout": "conservative_unknown_dependency",
    "blocked": "metadata_gap"
  },
  "delegation": {
    "specialists": [
      "citation_network_analyst",
      "ownership_researcher",
      "duplicate_detector"
    ],
    "spawn_when": [
      ">100_sources",
      "obscure_dependency"
    ],
    "tools": [
      "GRAPH",
      "TEXT_SIMILARITY",
      "READ_METADATA"
    ],
    "model_tier": "C-B",
    "reasoning_effort": "medium-high",
    "max_children": 10,
    "max_depth": 2,
    "verification": "omega_07_and_omega_03"
  },
  "model_routing": {
    "minimum_tier": "C",
    "default_tier": "B",
    "default_effort": "high",
    "escalate_when": [
      "covert_dependency_network"
    ],
    "deterministic_for": [
      "similarity",
      "clustering",
      "leave_one_out"
    ]
  },
  "context": {
    "always": [
      "independence_policy"
    ],
    "mission": [
      "evidence_metadata"
    ],
    "retrieved": [
      "ownership",
      "citation_graph"
    ],
    "forbidden": [
      "claim_conclusion_initially"
    ]
  },
  "memory": {
    "read": [
      "EvidenceLedger",
      "ProvenanceLedger"
    ],
    "append": [
      "SourceDependencyGraph"
    ],
    "propose": [
      "IndependenceAssessment"
    ],
    "verify": [
      "source_independence"
    ],
    "commit": [
      "SourceDependencyGraph"
    ],
    "revoke": [
      "obsolete_cluster"
    ]
  },
  "quality_gates": [
    "metadata",
    "edge_support",
    "cluster_stability",
    "orthogonality",
    "dominance",
    "unknown_penalty"
  ],
  "output_contract": {
    "artifacts": [
      "SourceDependencyGraph",
      "TriangulationReport"
    ],
    "schema_refs": [
      "evidence.schema.json",
      "artifact-envelope.schema.json"
    ]
  },
  "escalation": {
    "routes": {
      "metadata": "omega_06_omega_07",
      "replication": "omega_09",
      "fact": "omega_11"
    }
  },
  "failure_focus": [
    "copied_consensus",
    "hidden_dataset",
    "same_witness",
    "false_dependency",
    "graph_explosion"
  ],
  "security": {
    "tool_profile": [
      "READ_METADATA",
      "COMPUTE_SAFE"
    ],
    "human_required": [
      "sensitive_ownership_allegation"
    ]
  },
  "termination": {
    "done": [
      "sources_clustered",
      "dominance_quantified",
      "unknowns_visible"
    ],
    "stop": [
      "metadata_inaccessible",
      "saturation"
    ]
  },
  "production_ref": "../production-charters.json#/agents/9"
}
