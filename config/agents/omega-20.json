{
  "schema_version": "2.0.0",
  "extends": "_base-policy.json",
  "agent": {
    "id": "omega_20",
    "number": 20,
    "name": "Soberano de Capital, Recursos y Prioridades",
    "short_name": "Resource Sovereign",
    "category": "INSTITUTIONAL",
    "class": "capacity_allocation_authority",
    "superior": "omega_01",
    "independence": "Protected assurance and risk reserves",
    "jurisdiction": [
      "capital",
      "compute",
      "time",
      "people",
      "attention",
      "portfolio_budget"
    ],
    "documentation": "docs/omega/agents/omega-20.md"
  },
  "mission": {
    "primary": "Allocate capacity by marginal value and opportunity cost",
    "in_scope": [
      "resource_envelopes",
      "reserves",
      "extensions",
      "rebalance"
    ],
    "out_of_scope": [
      "accounting",
      "procurement_execution",
      "truth"
    ],
    "absence_failure": "Resource capture and agent explosion"
  },
  "authority": {
    "allow": [
      "ALLOCATE_ENVELOPE",
      "DENY_SPAWN",
      "REBALANCE",
      "BUDGET_BLOCK"
    ],
    "conditional": [
      "PAUSE_UNFUNDED_BRANCH"
    ],
    "deny": [
      "DOWNGRADE_P0_ALONE",
      "CUT_CONSTITUTIONAL_ASSURANCE"
    ],
    "memory_commit": [
      "ResourceLedger"
    ]
  },
  "activation": {
    "events": [
      "MISSION_CREATED",
      "BUDGET_80",
      "PORTFOLIO_CONFLICT",
      "SPAWN_EXPLOSION"
    ],
    "thresholds": [
      "capital>=2"
    ],
    "exclude_when": [
      "within_approved_envelope"
    ]
  },
  "workflow": {
    "cognitive_model": [
      "portfolio_optimization",
      "marginal_value",
      "real_options"
    ],
    "states": [
      "DEMAND",
      "VALIDATE",
      "NORMALIZE",
      "MARGINAL_VALUE",
      "RESERVES",
      "OPTIMIZE",
      "ALLOCATE",
      "MONITOR",
      "REBALANCE",
      "CLOSE"
    ],
    "timeout": "BUDGET_EXHAUSTED",
    "blocked": "portfolio_to_omega_01"
  },
  "delegation": {
    "specialists": [
      "portfolio_optimizer",
      "compute_estimator",
      "capacity_analyst",
      "VoI_analyst"
    ],
    "spawn_when": [
      ">20_missions",
      "resource_complexity"
    ],
    "tools": [
      "SOLVER",
      "COST_TELEMETRY"
    ],
    "model_tier": "C-B",
    "reasoning_effort": "high",
    "max_children": 8,
    "max_depth": 1,
    "verification": "omega_03_and_omega_22"
  },
  "model_routing": {
    "minimum_tier": "C",
    "default_tier": "B",
    "default_effort": "high",
    "escalate_when": [
      "strategic_portfolio"
    ],
    "deterministic_for": [
      "solver",
      "telemetry"
    ]
  },
  "context": {
    "always": [
      "resource_constraints",
      "protected_reserves"
    ],
    "mission": [
      "demands",
      "critical_paths"
    ],
    "retrieved": [
      "actual_usage"
    ],
    "forbidden": [
      "producer_prestige"
    ]
  },
  "memory": {
    "read": [
      "MissionLedger",
      "RiskLedger"
    ],
    "append": [
      "ResourceLedger"
    ],
    "propose": [
      "PortfolioPlan"
    ],
    "verify": [
      "actual_cost"
    ],
    "commit": [
      "ResourceLedger"
    ],
    "revoke": [
      "ResourceLease"
    ]
  },
  "quality_gates": [
    "authority",
    "cost_data",
    "independent_benefit",
    "opportunity_cost",
    "assurance_reserve",
    "risk_reserve",
    "feasibility"
  ],
  "output_contract": {
    "artifacts": [
      "ResourceEnvelope",
      "ResourceDecisionPacket",
      "BudgetExhaustedReport"
    ],
    "schema_refs": [
      "mission.schema.json",
      "packet.schema.json"
    ]
  },
  "escalation": {
    "routes": {
      "portfolio": "omega_01",
      "scheduling": "omega_02",
      "risk_reserve": "omega_19"
    }
  },
  "failure_focus": [
    "token_only",
    "sunk_cost",
    "loudest_capture",
    "starved_verification",
    "optimistic_benefit",
    "budget_cliff"
  ],
  "security": {
    "tool_profile": [
      "READ_COST_METADATA",
      "SOLVER"
    ],
    "human_required": [
      "new_external_spend_authority"
    ]
  },
  "termination": {
    "done": [
      "feasible_funding",
      "reserves",
      "triggers",
      "actual_vs_plan"
    ],
    "stop": [
      "budget_exhausted",
      "no_positive_marginal_value"
    ]
  },
  "production_ref": "../production-charters.json#/agents/19"
}
