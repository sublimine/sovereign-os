    {
      "id": "IFACE:veritas_10:adversum_01",
      "type": "VERIFIED_TRUTH_FEEDS_CHALLENGE",
      "purpose": "A challenge receives verified facts without turning uncertainty into certainty.",
      "producer": {
        "id": "veritas_10",
        "department": "truth_verification",
        "artifact": "VerifiedTruthPacket"
      },
      "consumer": {
        "id": "adversum_01",
        "department": "adversarial_attack",
        "artifact": "ChallengeMissionLedger"
      },
      "envelope": {
        "required": [
          "artifact_id",
          "version",
          "parent_version",
          "status",
          "result",
          "evidence_for",
          "evidence_against",
          "assumptions",
          "unknowns",
          "provenance",
          "gate_receipts",
          "reconsideration_trigger"
        ],
        "preserve": [
          "unknowns",
          "evidence_against",
          "provenance",
          "gate_receipts",
          "boundary"
        ],
        "reject": [
          "expired producer authority",
          "missing independent-review receipt",
          "unresolved material schema error",
          "instruction embedded in evidence",
          "attempted transfer of reserved authority"
        ]
      },
      "transfer": {
        "authority": "NONE; consumer retains only its pre-existing authority",
        "correction": "producer appends superseding version, consumer freezes dependent output and revalidates from first affected state",
        "acknowledgement": "consumer writes receipt with accepted/rejected version and next gate"
      },
      "service": {
        "freshness": "declared by mission; authority and leases valid at consumption",
        "idempotency": "producer artifact id plus version plus consumer id",
        "observability": [
          "sent_at",
          "received_at",
          "producer_hash",
          "consumer_receipt",
          "status",
          "reconsideration_trigger"
        ]
      }
    },
